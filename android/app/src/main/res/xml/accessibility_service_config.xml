<?xml version="1.0" encoding="utf-8"?>
<!--
  packageNames is intentionally unset. The service must see the foreground
  window change when Florence leaves WhatsApp so the suggestion bar is removed.
  Event handling ignores every package except WhatsApp and does not read other apps.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:canRetrieveWindowContent="true"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:description="@string/accessibility_description" />
